{
  "name": "@shbernal/rampkit-cli",
  "version": "0.1.0",
  "description": "CLI and interactive TUI for generating Tailwind-style color ramps with rampkit.",
  "type": "module",
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "color",
    "palette",
    "ramp",
    "cli",
    "tui",
    "ink",
    "oklch"
  ],
  "bin": {
    "rampkit": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/rampkit.git",
    "directory": "packages/app"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@shbernal/rampkit": "workspace:*",
    "culori": "^4.0.2",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  }
}
