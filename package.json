{
  "name": "rampkit-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/core build && bun run --cwd packages/app build",
    "test": "bun test",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/app typecheck",
    "dev": "bun run --cwd packages/app dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
