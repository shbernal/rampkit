{
  "name": "rampkit-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/core build && bun run --cwd packages/app build",
    "test": "bun test",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/app typecheck",
    "dev": "bun run --cwd packages/app dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  }
}
