{
  "name": "rampkit-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/core build && bun run --cwd packages/app build",
    "test": "bun test",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/app typecheck",
    "dev": "bun run --cwd packages/app dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
